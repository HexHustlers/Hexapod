#include <Wire.h>
#include <Adafruit_PWMServoDriver.h>

Adafruit_PWMServoDriver pwm = Adafruit_PWMServoDriver(0x40);

// PCA9685 channels
#define COXA   0
#define FEMUR  1
#define TIBIA  2

// MG996R approximate pulse range
#define SERVO_MIN  150
#define SERVO_MAX  600

// Current angles
int coxaAngle  = 90;
int femurAngle = 90;
int tibiaAngle = 90;


// Convert angle (0-180) to PCA9685 pulse
int angleToPulse(int angle)
{
  return map(angle, 0, 180, SERVO_MIN, SERVO_MAX);
}


// Move a servo
void moveServo(uint8_t channel, int angle)
{
  angle = constrain(angle, 0, 180);

  int pulse = angleToPulse(angle);

  pwm.setPWM(channel, 0, pulse);
}


// Move the entire leg
void moveLeg(int coxa, int femur, int tibia)
{
  moveServo(COXA, coxa);
  moveServo(FEMUR, femur);
  moveServo(TIBIA, tibia);

  coxaAngle = coxa;
  femurAngle = femur;
  tibiaAngle = tibia;
}


void setup()
{
  Serial.begin(115200);

  pwm.begin();

  // MG996R uses approximately 50 Hz
  pwm.setPWMFreq(50);

  delay(500);

  // Home position
  moveLeg(90, 90, 90);

  Serial.println("================================");
  Serial.println("   SINGLE LEG CONTROLLER");
  Serial.println("================================");

  Serial.println();
  Serial.println("Commands:");
  Serial.println("C90  -> Coxa to 90 degrees");
  Serial.println("F90  -> Femur to 90 degrees");
  Serial.println("T90  -> Tibia to 90 degrees");
  Serial.println("H    -> Home position");
  Serial.println("S    -> Show current angles");

  Serial.println();
}


void loop()
{
  if (Serial.available())
  {
    String command = Serial.readStringUntil('\n');

    command.trim();
    command.toUpperCase();

    // Coxa
    if (command.startsWith("C"))
    {
      int angle = command.substring(1).toInt();

      moveServo(COXA, angle);

      coxaAngle = constrain(angle, 0, 180);

      Serial.print("Coxa = ");
      Serial.println(coxaAngle);
    }

    // Femur
    else if (command.startsWith("F"))
    {
      int angle = command.substring(1).toInt();

      moveServo(FEMUR, angle);

      femurAngle = constrain(angle, 0, 180);

      Serial.print("Femur = ");
      Serial.println(femurAngle);
    }

    // Tibia
    else if (command.startsWith("T"))
    {
      int angle = command.substring(1).toInt();

      moveServo(TIBIA, angle);

      tibiaAngle = constrain(angle, 0, 180);

      Serial.print("Tibia = ");
      Serial.println(tibiaAngle);
    }

    // Home
    else if (command == "H")
    {
      moveLeg(90, 90, 90);

      Serial.println("Leg moved to HOME position.");
    }

    // Show angles
    else if (command == "S")
    {
      Serial.print("Coxa  : ");
      Serial.println(coxaAngle);

      Serial.print("Femur : ");
      Serial.println(femurAngle);

      Serial.print("Tibia : ");
      Serial.println(tibiaAngle);
    }

    else
    {
      Serial.println("Unknown command.");
    }
  }
}
